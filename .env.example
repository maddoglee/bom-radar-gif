# Docker Compose environment settings for bom-radar-gif
# Copy this file to .env and customize as needed

RADAR_APP_DIR=/app
RADAR_FILES_DIR=/app/bomradarfiles
RADAR_OUTPUT_GIF=/app/output/radar.gif
RADAR_BACKGROUND_IMAGE=/app/bomradarfiles/IDR034.Background1.png
RADAR_LOCATIONS_IMAGE=/app/bomradarfiles/IDR034.locations1.png
RADAR_FTP_HOST=ftp.bom.gov.au
RADAR_FTP_TRANSPARENCIES_DIR=/anon/gen/radar_transparencies/
RADAR_FTP_RADAR_DIR=/anon/gen/radar/
RADAR_MAX_FRAMES=5

# Wrapper script settings
RADAR_PROCESS_NAME=bomradargif_STATIC.py
RADAR_PYTHON=python
RADAR_SCRIPT=/app/bomradargif_STATIC.py
RADAR_LOG_FILE=/app/log/radar_process.log
RADAR_CHECK_AGE_MINUTES=10
